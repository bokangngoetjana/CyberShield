@page
@model IndexModel
@{
    ViewData["Title"] = "CyberShield";
}

<div class="cs-header">
    <div class="cs-shield" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 4 40 10v12c0 10-7 17-16 22C15 39 8 32 8 22V10L24 4Z" stroke="currentColor" stroke-width="2.5"/><path d="m16 24 5 5 11-12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <p class="cs-eyebrow">Your digital safety toolkit</p>
    <h1>CyberShield</h1>
    <p>Verify suspicious messages, links, and documents before you act.</p>
</div>

<ul class="nav nav-tabs" id="cyberShieldTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="message-tab" data-bs-toggle="tab" data-bs-target="#message-panel" type="button" role="tab" aria-controls="message-panel" aria-selected="true">
            Message Scanner
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="link-tab" data-bs-toggle="tab" data-bs-target="#link-panel" type="button" role="tab" aria-controls="link-panel" aria-selected="false">
            Link &amp; Document Checker
        </button>
    </li>
</ul>

<div class="tab-content p-4" id="cyberShieldTabContent">

    <!-- MESSAGE SCANNER PANEL -->
    <div class="tab-pane fade show active" id="message-panel" role="tabpanel" aria-labelledby="message-tab">
        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary" id="sampleScamBtn">Try a sample scam SMS</button>
        </div>
        <label for="messageInput" class="form-label fw-semibold">Message to scan</label>
        <textarea id="messageInput" class="form-control mb-3" rows="6" placeholder="Paste the SMS, email, or job ad text here..."></textarea>
        <button id="scanMessageBtn" class="btn btn-primary">Scan Message</button>
        <div id="messageSpinner" class="spinner-border text-primary ms-2 d-none" role="status"><span class="visually-hidden">Scanning…</span></div>

        <div id="messageResult" aria-live="polite" aria-atomic="true" class="mt-4 d-none"></div>
    </div>

    <!-- LINK & DOCUMENT CHECKER PANEL -->
    <div class="tab-pane fade" id="link-panel" role="tabpanel" aria-labelledby="link-tab">
        <h2 class="h5"><label for="urlInput">Check a URL</label></h2>
        <div class="mb-2">
            <button class="btn btn-sm btn-outline-secondary" id="sampleUrlBtn">Try a known-bad URL</button>
        </div>
        <div class="input-group mb-3">
            <input type="text" id="urlInput" class="form-control" placeholder="https://example.com">
            <button id="checkUrlBtn" class="btn btn-primary">Check URL</button>
        </div>
        <div id="urlSpinner" class="spinner-border text-primary d-none mb-3" role="status"><span class="visually-hidden">Scanning…</span></div>
        <div id="urlResult" aria-live="polite" aria-atomic="true" class="mb-4 d-none"></div>

        <hr>

        <h2 class="h5"><label for="imageInput">Check a Document / Image</label></h2>
        <input type="file" id="imageInput" class="form-control mb-3" accept="image/*">
        <button id="checkImageBtn" class="btn btn-primary">Check Image</button>
        <div id="imageSpinner" class="spinner-border text-primary ms-2 d-none" role="status"><span class="visually-hidden">Scanning…</span></div>

        <div id="imageResult" aria-live="polite" aria-atomic="true" class="mt-4 d-none"></div>
    </div>

</div>

@section Scripts {
    <script src="~/js/cybershield.js" asp-append-version="true"></script>
}